{
  "name": "ai-factory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:local && FACTORY_DB=local INNGEST_DEV=http://127.0.0.1:8288 next dev -H 127.0.0.1 -p 4100",
    "dev:neon": "INNGEST_DEV=http://127.0.0.1:8288 next dev -H 127.0.0.1 -p 4100",
    "db:local": "docker compose up -d --wait db && FACTORY_DB=local tsx --tsconfig tsconfig.json src/db/migrate-cli.ts",
    "db:migrate": "npm run db:local",
    "db:local:stop": "docker compose stop db",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:neon": "tsx --env-file=.env.local --tsconfig tsconfig.json src/db/migrate-cli.ts",
    "seed": "tsx src/db/seed.ts",
    "inngest": "npx inngest-cli dev --host 127.0.0.1 -u http://127.0.0.1:4100/api/inngest",
    "db:generate": "drizzle-kit generate --config drizzle.pg.config.ts",
    "db:copy-from-sqlite": "tsx --env-file=.env.local --tsconfig tsconfig.json src/db/copy-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@electric-sql/pglite": "^0.5.16",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@xyflow/react": "^12.12.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "inngest": "^4.26.2",
    "next": "16.0.0",
    "pg": "^8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
